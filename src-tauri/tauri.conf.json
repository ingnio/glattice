{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glattice",
  "version": "0.1.0",
  "identifier": "com.getglattice.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:17313",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glattice",
        "width": 460,
        "height": 910,
        "minWidth": 280,
        "minHeight": 220,
        "dragDropEnabled": true,
        "backgroundColor": "#f7f8fb"
      },
      {
        "label": "indicator",
        "url": "index.html?view=indicator",
        "title": "",
        "width": 2560,
        "height": 1600,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Glattice",
    "shortDescription": "Screen recorder and annotation tool",
    "longDescription": "Record your screen, annotate individual frames, then export as an animated GIF, MP4, WebM, or a sprite sheet.",
    "category": "GraphicsAndDesign",
    "licenseFile": "../EULA.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["gif"],
        "name": "Animated GIF",
        "description": "Open in Glattice",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
