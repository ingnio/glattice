{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glattice",
  "version": "0.3.0",
  "identifier": "com.getglattice.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:17313",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glattice",
        "width": 460,
        "height": 910,
        "minWidth": 280,
        "minHeight": 220,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#f7f8fb"
      },
      {
        "label": "indicator",
        "url": "index.html?view=indicator",
        "title": "",
        "width": 2560,
        "height": 1600,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost ipc: http://ipc.localhost ws://localhost:17313 http://localhost:17313",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Glattice",
    "shortDescription": "Screen recorder, screenshot and annotation tool",
    "longDescription": "Record your screen or take a screenshot, mark it up, then share it as an animated GIF, MP4, WebM, a sprite sheet, an annotated image, or a step-by-step guide.",
    "category": "GraphicsAndDesign",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "assets/OFL.txt": "licenses/RobotoMono-OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["gif"],
        "name": "Glattice.AnimatedGif",
        "description": "Animated GIF",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
